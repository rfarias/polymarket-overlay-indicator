PORT=8787
POLYMARKET_MARKET_WS=wss://ws-subscriptions-clob.polymarket.com/ws/market
POLYMARKET_RTDS_WS=wss://ws-live-data.polymarket.com
# Optional comma-separated explicit market IDs to subscribe on market channel.
MARKET_IDS=
# Optional external WS for BTC price comparison (must send BTC price payloads)
EXTERNAL_PRICE_WS=
# Refresh interval for overlay polling (ms)
OVERLAY_REFRESH_MS=500
# Enable verbose incoming feed logs
DEBUG_FEEDS=false
